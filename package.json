{
  "version": "0.0.2",
  "name": "@tomheten/browser-control-tool",
  "author": {
    "name": "Boris Medoshin",
    "url": "https://github.com/Tomheten"
  },
  "license": "MIT",
  "main": "dist/browser-control-tool.cjs.js",
  "module": "dist/browser-control-tool.esm.js",
  "exports": {
    ".": {
      "import": "./dist/browser-control-tool.esm.js",
      "require": "./dist/browser-control-tool.cjs.js"
    }
  },
  "types": "dist/index.d.ts",
  "contributors": [
    {
      "name": "Boris Prokhorov",
      "url": "https://github.com/lixonik"
    }
  ],
  "files": [
    "dist",
    "widgets/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "vite",
    "typescript",
    "browser",
    "playwright"
  ],
  "scripts": {
    "vite": "vite",
    "vue-tsc": "vue-tsc",
    "dev": "vite",
    "dev:widgets": "vite --config ./widgets/vite.build-widgets.config.ts",
    "build:lib": "vite build --config ./vite.build-lib.config.ts",
    "build:widgets": "node widgets/build-widgets.ts",
    "vite-node": "vite-node",
    "run": "vite-node playwright/run.ts",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "node scripts/prepublish.mts"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@playwright/test": "^1.57.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.14",
    "vue": "^3.5.25",
    "vuetify": "^3.11.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "vue-tsc": "^3.1.5",
    "vite-node": "^5.2.0",
    "vite-plugin-checker": "^0.11.0"
  }
}
