{
  "version": "0.0.21",
  "name": "@tomheten/browser-control-tool",
  "author": {
    "name": "Boris Medoshin",
    "url": "https://github.com/Tomheten"
  },
  "license": "MIT",
  "main": "dist/browser-control-tool.cjs.js",
  "module": "dist/browser-control-tool.esm.js",
  "exports": {
    ".": {
      "import": "./dist/browser-control-tool.esm.js",
      "require": "./dist/browser-control-tool.cjs.js"
    }
  },
  "bin": {
    "browser-control-tool": "./bin/cli.js",
    "bctool": "./bin/cli.js"
  },
  "types": "dist/index.d.ts",
  "contributors": [
    {
      "name": "Boris Prokhorov",
      "url": "https://github.com/lixonik"
    }
  ],
  "files": [
    "bin",
    "dist",
    "widgets/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "report",
    "tool",
    "browser",
    "playwright"
  ],
  "scripts": {
    "vite": "vite",
    "vue-tsc": "vue-tsc",
    "dev": "vite",
    "dev:ui": "vite --config ./widgets/vite.build-ui.config.ts",
    "build:lib": "vite build --config ./vite.build-lib.config.ts",
    "build:ui": "node widgets/build-ui.ts",
    "vite-node": "vite-node",
    "run": "vite-node playwright/run.ts",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "node scripts/prepublish.mts"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "ionicons": "8.1.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@types/node": "~26.6.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "vuetify": "^4.2.6",
    "feather-icons": "^4.29.2",
    "tsx": "4.23.15"
  }
}